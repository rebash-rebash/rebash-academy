direction: right
*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
IN: "variables\n+ data" { style.fill: "#dbeafe"; style.stroke: "#2563eb"; style.font-color: "#1e3a8a" }
FN: "functions\njoin, lookup, templatefile" { style.fill: "#dcfce7"; style.stroke: "#16a34a"; style.font-color: "#14532d" }
DYN: "dynamic blocks" { style.fill: "#ffedd5"; style.stroke: "#ea580c"; style.font-color: "#9a3412" }
OUT: "resource\narguments" { style.fill: "#f3e8ff"; style.stroke: "#9333ea"; style.font-color: "#581c87" }
IN -> FN -> OUT
FN -> DYN -> OUT

