direction: down
*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
A: "local_file.a" { style.fill: "#dbeafe"; style.stroke: "#2563eb"; style.font-color: "#1e3a8a" }
B: "local_file.b\ncontent from a" { style.fill: "#dcfce7"; style.stroke: "#16a34a"; style.font-color: "#14532d" }
C: "terraform_data.c\ndepends on b" { style.fill: "#ffedd5"; style.stroke: "#ea580c"; style.font-color: "#9a3412" }
A -> B: "implicit"
B -> C: "depends_on"

