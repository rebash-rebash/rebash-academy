direction: right
Subnet: "Public subnet" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
RT: "Route table" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
IGW: "Internet Gateway" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
Net: "Internet" { style.fill: "#fee2e2"; style.stroke: "#b91c1c" }
Subnet -> RT -> IGW -> Net
