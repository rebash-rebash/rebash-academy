*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
direction: right
Sample: "Sample logs\npathlib" { style.fill: "#fee2e2"; style.stroke: "#dc2626" }
Parse: "Regex parse\nnamed groups" { style.fill: "#fef9c3"; style.stroke: "#ca8a04" }
Aggregate: "Counts &\nlevels" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
