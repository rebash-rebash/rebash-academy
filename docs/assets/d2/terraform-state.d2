direction: right
*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
CFG: "config\naddress" { style.fill: "#dbeafe"; style.stroke: "#2563eb"; style.font-color: "#1e3a8a" }
ST: "state\nID + attrs" { style.fill: "#dcfce7"; style.stroke: "#16a34a"; style.font-color: "#14532d" }
REAL: "real resource" { style.fill: "#ffedd5"; style.stroke: "#ea580c"; style.font-color: "#9a3412" }
CFG -> ST: "maps"
ST -> REAL: "tracks"
REAL -> ST: "refresh"

