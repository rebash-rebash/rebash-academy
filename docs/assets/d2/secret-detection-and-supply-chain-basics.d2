direction: right
Commit: "Commit" { style.fill: "#fee2e2"; style.stroke: "#b91c1c" }
Detect: "Secret detect" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
SBOM: "SBOM / provenance" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
Block: "Block merge" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
Commit -> Detect -> Block
Commit -> SBOM
