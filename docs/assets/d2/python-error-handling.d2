        *: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
direction: right
A: "Operation" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
        B: "try / except" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
        C: "Custom errors" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
        D: "Exit code" { style.fill: "#fce7f3"; style.stroke: "#db2777" }
        A -> B -> C -> D
