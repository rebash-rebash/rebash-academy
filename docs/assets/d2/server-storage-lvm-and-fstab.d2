direction: right
Disk: "Disk / loop\nPV" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
VG: "Volume\ngroup" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
LV: "Logical\nvolume" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
FS: "Filesystem\n+ fstab UUID" { style.fill: "#e0e7ff"; style.stroke: "#4338ca" }
Disk -> VG -> LV -> FS
