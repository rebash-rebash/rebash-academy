direction: right
Fail: "Failed job" { style.fill: "#fee2e2"; style.stroke: "#b91c1c" }
Log: "Read logs" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
Fix: "Fix YAML" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
Green: "Green pipeline" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
Fail -> Log -> Fix -> Green
