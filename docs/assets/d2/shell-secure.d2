*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
direction: right
Input: "untrusted\ninput" { style.fill: "#fee2e2"; style.stroke: "#dc2626" }
Validate: "validate\nquote" { style.fill: "#fef9c3"; style.stroke: "#ca8a04" }
Action: "safe action" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
Input -> Validate -> Action
