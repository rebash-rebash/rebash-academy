direction: right

Start: "Feature branch\nbehind main" {
  style.fill: "#fee2e2"
  style.stroke: "#b91c1c"
}

Rebase: "rebase onto\nmain + conflict" {
  style.fill: "#dbeafe"
  style.stroke: "#1d4ed8"
}

Mistake: "Secret file\ncommitted" {
  style.fill: "#ffedd5"
  style.stroke: "#c2410c"
}

Recover: "revert / reset\nreflog check" {
  style.fill: "#e0e7ff"
  style.stroke: "#4338ca"
}

Push: "push\n--force-with-lease" {
  style.fill: "#dcfce7"
  style.stroke: "#15803d"
}

PR: "Clean history\nready for review" {
  style.fill: "#d1fae5"
  style.stroke: "#047857"
}

Start -> Rebase -> Mistake -> Recover -> Push -> PR
