direction: right
*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }

Addr: "IP address\nhost + network" {
  style.fill: "#dbeafe"
  style.stroke: "#2563eb"
  style.font-color: "#1e3a8a"
}
Mask: "Subnet mask\n/CIDR prefix" {
  style.fill: "#dcfce7"
  style.stroke: "#16a34a"
  style.font-color: "#14532d"
}
Net: "Network &\nbroadcast" {
  style.fill: "#ffedd5"
  style.stroke: "#ea580c"
  style.font-color: "#9a3412"
}
Hosts: "Usable hosts\n& VLSM plan" {
  style.fill: "#f3e8ff"
  style.stroke: "#9333ea"
  style.font-color: "#581c87"
}
Cloud: "VPC / subnet\nCIDR design" {
  style.fill: "#fce7f3"
  style.stroke: "#db2777"
  style.font-color: "#9d174d"
}

Addr -> Mask -> Net -> Hosts -> Cloud
