        *: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
direction: right
A: "python3 -m venv" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
        B: ".venv isolate" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
        C: "pip / uv pins" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
        D: "Ops tool runs" { style.fill: "#fce7f3"; style.stroke: "#db2777" }
        A -> B -> C -> D
