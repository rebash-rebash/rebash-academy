direction: right
*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
PLAN: "terraform plan\nJSON" { style.fill: "#dbeafe"; style.stroke: "#2563eb"; style.font-color: "#1e3a8a" }
POL: "Policy engine\nOPA / Sentinel" { style.fill: "#dcfce7"; style.stroke: "#16a34a"; style.font-color: "#14532d" }
GATE: "allow / deny\nbefore apply" { style.fill: "#ffedd5"; style.stroke: "#ea580c"; style.font-color: "#9a3412" }
PLAN -> POL -> GATE

