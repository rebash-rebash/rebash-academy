direction: right

*: {
  style: {
    border-radius: 14
    font-size: 14
    bold: true
    shadow: true
    stroke-width: 2
  }
}

count: "count\nindex" {
  style.fill: "#dbeafe"
  style.stroke: "#2563eb"
  style.font-color: "#1e3a8a"
}

for_each: "for_each\nkey (prefer)" {
  style.fill: "#dcfce7"
  style.stroke: "#16a34a"
  style.font-color: "#14532d"
}

instances: "expanded\ninstances" {
  style.fill: "#e0e7ff"
  style.stroke: "#4338ca"
  style.font-color: "#312e81"
}

lifecycle: "lifecycle\n(optional)" {
  style.fill: "#ffedd5"
  style.stroke: "#ea580c"
  style.font-color: "#9a3412"
}

provisioners: "provisioners\navoid" {
  style.fill: "#fce7f3"
  style.stroke: "#db2777"
  style.font-color: "#9d174d"
}

count -> instances: "or"
for_each -> instances: "or"
instances -> lifecycle
