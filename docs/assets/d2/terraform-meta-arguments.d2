direction: right
*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
C: "count\nindex" { style.fill: "#dbeafe"; style.stroke: "#2563eb"; style.font-color: "#1e3a8a" }
F: "for_each\nkey" { style.fill: "#dcfce7"; style.stroke: "#16a34a"; style.font-color: "#14532d" }
L: "lifecycle\nrules" { style.fill: "#ffedd5"; style.stroke: "#ea580c"; style.font-color: "#9a3412" }
P: "provisioner\navoid" { style.fill: "#fce7f3"; style.stroke: "#db2777"; style.font-color: "#9d174d" }
C -> F: "prefer"
F -> L

