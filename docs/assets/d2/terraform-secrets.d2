direction: down
*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
OK: "sensitive vars\nsecret managers\nCI secrets" { style.fill: "#dcfce7"; style.stroke: "#16a34a"; style.font-color: "#14532d" }
BAD: "plaintext tfvars\nin Git\nstate leaks" { style.fill: "#fee2e2"; style.stroke: "#dc2626"; style.font-color: "#991b1b" }
CODE: "Terraform config" { style.fill: "#dbeafe"; style.stroke: "#2563eb"; style.font-color: "#1e3a8a" }
OK -> CODE
BAD -> CODE: "avoid"

