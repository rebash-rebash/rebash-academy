*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
direction: right
Input: "Args / files" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
Test: "[[ ]] / case" { style.fill: "#fef9c3"; style.stroke: "#ca8a04" }
Branch: "Branch" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
Action: "Action" { style.fill: "#f3e8ff"; style.stroke: "#9333ea" }
Input -> Test -> Branch -> Action
