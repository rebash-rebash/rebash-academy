direction: right
Clients: "Clients" { style.fill: "#fee2e2"; style.stroke: "#b91c1c" }
LB: "Load balancer\nL4 / L7" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
Healthy: "Backend A\nhealthy" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
Sick: "Backend B\nfailing HC" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
HC: "Health check\nloop" { style.fill: "#e0e7ff"; style.stroke: "#4338ca" }
Clients -> LB
LB -> Healthy
LB -> Sick: "drain /\nremove" { style.stroke: "#b91c1c" }
HC -> Healthy
HC -> Sick
