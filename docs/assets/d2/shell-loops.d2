*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
direction: right
Source: "Glob / file\n/ argv" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
Iter: "for / while\nread -r" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
Body: "Loop body" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
Source -> Iter -> Body
