direction: right
*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
CFG: "required_providers" { style.fill: "#dbeafe"; style.stroke: "#2563eb"; style.font-color: "#1e3a8a" }
REG: "Registry\nplugins" { style.fill: "#dcfce7"; style.stroke: "#16a34a"; style.font-color: "#14532d" }
PLUG: "Provider plugin\nin .terraform/" { style.fill: "#ffedd5"; style.stroke: "#ea580c"; style.font-color: "#9a3412" }
API: "Cloud / local APIs" { style.fill: "#f3e8ff"; style.stroke: "#9333ea"; style.font-color: "#581c87" }
CFG -> REG -> PLUG -> API

