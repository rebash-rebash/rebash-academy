*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
direction: right
Input: "Fixture inventory\nor cloud SDK" { style.fill: "#fee2e2"; style.stroke: "#dc2626" }
Normalise: "Common record\nid · type · tags" { style.fill: "#fef9c3"; style.stroke: "#ca8a04" }
Filter: "State / labels\ncompliance flags" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
Output: "inventory.json\nCSV export" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
Input -> Normalise -> Filter -> Output
