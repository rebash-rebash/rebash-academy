*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
direction: right
Main: "main script" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
Lib: "lib/*.sh" { style.fill: "#f3e8ff"; style.stroke: "#9333ea" }
Fn: "functions\nlocal" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
Main -> Lib -> Fn
Main -> Fn
