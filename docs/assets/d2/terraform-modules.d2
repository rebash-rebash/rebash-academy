direction: right
*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
ROOT: "Root module" { style.fill: "#dbeafe"; style.stroke: "#2563eb"; style.font-color: "#1e3a8a" }
CH: "Child module\ninputs/outputs" { style.fill: "#dcfce7"; style.stroke: "#16a34a"; style.font-color: "#14532d" }
RES: "Resources\ninside module" { style.fill: "#ffedd5"; style.stroke: "#ea580c"; style.font-color: "#9a3412" }
ROOT -> CH: "module block"
CH -> RES

