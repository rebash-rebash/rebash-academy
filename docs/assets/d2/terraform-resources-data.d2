direction: right
*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
RES: "resource\ncreate/update/delete" { style.fill: "#dbeafe"; style.stroke: "#2563eb"; style.font-color: "#1e3a8a" }
DATA: "data\nread existing" { style.fill: "#dcfce7"; style.stroke: "#16a34a"; style.font-color: "#14532d" }
STATE: "state" { style.fill: "#ffedd5"; style.stroke: "#ea580c"; style.font-color: "#9a3412" }
WORLD: "real world\nobjects" { style.fill: "#f3e8ff"; style.stroke: "#9333ea"; style.font-color: "#581c87" }
RES -> STATE
RES -> WORLD
DATA -> WORLD: "query"
DATA -> RES: "attributes"

