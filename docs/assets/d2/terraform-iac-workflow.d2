direction: right

*: {
  style: {
    border-radius: 14
    font-size: 15
    bold: true
    shadow: true
    stroke-width: 2
  }
}

(** -> **)[*]: {
  style.stroke-width: 2
  style.font-size: 13
  style.bold: true
  style.font-color: "#0f172a"
}

CODE: "HCL Configuration\n*.tf files" {
  style.fill: "#dbeafe"
  style.stroke: "#2563eb"
  style.font-color: "#1e3a8a"
}

CLI: "Terraform CLI\ninit · plan · apply" {
  style.fill: "#dcfce7"
  style.stroke: "#16a34a"
  style.font-color: "#14532d"
}

STATE: "State\nterraform.tfstate" {
  style.fill: "#ffedd5"
  style.stroke: "#ea580c"
  style.font-color: "#9a3412"
}

PROV: "Providers\nAWS · Azure · GCP · local" {
  style.fill: "#f3e8ff"
  style.stroke: "#9333ea"
  style.font-color: "#581c87"
}

INFRA: "Real Infrastructure\nAPIs create & update resources" {
  style.fill: "#fce7f3"
  style.stroke: "#db2777"
  style.font-color: "#9d174d"
}

CODE -> CLI: "desired state"
CLI -> STATE: "records IDs &\nattributes"
CLI -> PROV: "CRUD via plugins"
PROV -> INFRA: "cloud / local APIs"
INFRA -> STATE: "refresh &\nreconcile"
