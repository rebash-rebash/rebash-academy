direction: down
*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
CODE: "Same config\n*.tf" { style.fill: "#dbeafe"; style.stroke: "#2563eb"; style.font-color: "#1e3a8a" }
DEV: "workspace: dev\nstate A" { style.fill: "#dcfce7"; style.stroke: "#16a34a"; style.font-color: "#14532d" }
STG: "workspace: staging\nstate B" { style.fill: "#ffedd5"; style.stroke: "#ea580c"; style.font-color: "#9a3412" }
PRD: "workspace: prod\nstate C" { style.fill: "#f3e8ff"; style.stroke: "#9333ea"; style.font-color: "#581c87" }
CODE -> DEV
CODE -> STG
CODE -> PRD

