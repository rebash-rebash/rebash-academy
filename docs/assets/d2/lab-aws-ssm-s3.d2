direction: right
Op: "Operator" { style.fill: "#fee2e2"; style.stroke: "#b91c1c" }
SSM: "SSM" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
EC2: "EC2 + instance role" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
