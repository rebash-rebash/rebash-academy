direction: right
Src: "Server\ndata + /etc" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
Bak: "Backup\ntar/rsync" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
Ver: "Checksum\nverify" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
Rst: "Restore\ndrill" { style.fill: "#e0e7ff"; style.stroke: "#4338ca" }
Src -> Bak -> Ver -> Rst
