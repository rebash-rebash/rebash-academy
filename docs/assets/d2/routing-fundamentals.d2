direction: right

LAN1: "Subnet 10.0.1.0/24" {
      style: {
        fill: "#dbeafe"
        stroke: "#2563eb"
      }
        H1: "Host 10.0.1.10"
    }
    LAN2: "Subnet 10.0.2.0/24" {
      style: {
        fill: "#dcfce7"
        stroke: "#16a34a"
      }
        H2: "Host 10.0.2.20"
    }
    LAN3: "Subnet 10.0.3.0/24" {
      style: {
        fill: "#ffedd5"
        stroke: "#ea580c"
      }
        DB: "Database 10.0.3.5"
    }
    R1: "Router R1\n10.0.1.1 · 10.0.2.1"
    R2: "Router R2\n10.0.2.2 · 10.0.3.1"
    IGW: "Internet Gateway"
    LAN1.H1 -> R1
    R1 -> R2
    R2 -> LAN3.DB
    R2 -> IGW
    LAN2.H2 -> R1
