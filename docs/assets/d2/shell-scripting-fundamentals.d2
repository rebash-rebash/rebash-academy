direction: right
*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
Shebang: "Shebang\n/usr/bin/env bash" { style.fill: "#dbeafe"; style.stroke: "#2563eb"; style.font-color: "#1e3a8a" }
Strict: "Strict mode\nset -euo pipefail" { style.fill: "#dcfce7"; style.stroke: "#16a34a"; style.font-color: "#14532d" }
Args: "Args / env" { style.fill: "#ffedd5"; style.stroke: "#ea580c"; style.font-color: "#9a3412" }
Flow: "if / loops\nfunctions" { style.fill: "#f3e8ff"; style.stroke: "#9333ea"; style.font-color: "#581c87" }
Exit: "Exit status\nlogs" { style.fill: "#fce7f3"; style.stroke: "#db2777"; style.font-color: "#9d174d" }
Shebang -> Strict -> Args -> Flow -> Exit
