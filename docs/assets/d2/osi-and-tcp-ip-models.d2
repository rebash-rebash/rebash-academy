direction: down

APP: "Application Layer" {
      style: {
        fill: "#dbeafe"
        stroke: "#2563eb"
      }
        DATA: "Application Data\nHTTP JSON DNS"
    }
    L47: "OSI Layers 5-7 / TCP/IP Application" {
      style: {
        fill: "#dcfce7"
        stroke: "#16a34a"
      }
        L7: "L7 Application — HTTP TLS DNS"
        L6: "L6 Presentation — Encoding TLS"
        L5: "L5 Session — Connection mgmt"
    }
    L4: "Layer 4 — Transport" {
      style: {
        fill: "#ffedd5"
        stroke: "#ea580c"
      }
        L4N: "TCP / UDP\nSegment + Port"
    }
    L3: "Layer 3 — Network" {
      style: {
        fill: "#f3e8ff"
        stroke: "#9333ea"
      }
        L3N: "IP — Packet + IP addr"
    }
    L2: "Layer 2 — Data Link" {
      style: {
        fill: "#fce7f3"
        stroke: "#db2777"
      }
        L2N: "Ethernet — Frame + MAC"
    }
    L1: "Layer 1 — Physical" {
      style: {
        fill: "#e0f2f1"
        stroke: "#00796b"
      }
        L1N: "Bits on wire / fiber / radio"
    }
    APP.DATA -> L47.L7
    L47.L7 -> L47.L6
    L47.L6 -> L47.L5
    L47.L5 -> L4.L4N
    L4.L4N -> L3.L3N
    L3.L3N -> L2.L2N
    L2.L2N -> L1.L1N
