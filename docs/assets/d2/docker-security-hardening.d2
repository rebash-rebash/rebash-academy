direction: down

HOST: "Host kernel + patches"
    SECCOMP: "seccomp profile\nsyscall filter"
    CAPS: "Linux capabilities\nCAP_DROP / CAP_ADD"
    USER: "Non-root UID / GID"
    RO: "Read-only rootfs + tmpfs"
    APP: "Application code"
    HOST -> SECCOMP
    SECCOMP -> CAPS
    CAPS -> USER
    USER -> RO
    RO -> APP
