direction: right

Host: Host {
        CTX: "Build Context\ndirectory on disk"
        DF: Dockerfile
        CLI: "docker build"
    }
    Engine: Engine {
        DA: "Docker daemon"
        CACHE: "Layer cache"
    }
    Output: Output {
        IMG: "Local image\nrepo:tag"
    }
    Host.CTX -> Host.CLI
    Host.DF -> Host.CLI
    Host.CLI -> Engine.DA
    Engine.DA -> Engine.CACHE
    Engine.DA -> Output.IMG
