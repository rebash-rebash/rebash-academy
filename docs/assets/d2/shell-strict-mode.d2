*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
direction: right
Cmd: "Command" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
Status: "Exit status" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
Strict: "set -euo\npipefail" { style.fill: "#fef9c3"; style.stroke: "#ca8a04" }
Out: "Continue / abort" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
Cmd -> Status -> Strict -> Out
