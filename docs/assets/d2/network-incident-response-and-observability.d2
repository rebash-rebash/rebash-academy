direction: right
Alert: "Alert /\nuser report" { style.fill: "#fee2e2"; style.stroke: "#b91c1c" }
Scope: "Scope +\nblast radius" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
Evidence: "Evidence\ncurl dig ss mtr" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
Capture: "tcpdump /\nmetrics" { style.fill: "#e0e7ff"; style.stroke: "#4338ca" }
Fix: "Mitigate +\nverify" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
Alert -> Scope -> Evidence -> Capture -> Fix
