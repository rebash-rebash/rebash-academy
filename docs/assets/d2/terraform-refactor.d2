direction: right
*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
OLD: "old address\nin state" { style.fill: "#dbeafe"; style.stroke: "#2563eb"; style.font-color: "#1e3a8a" }
MV: "moved /\nimport" { style.fill: "#dcfce7"; style.stroke: "#16a34a"; style.font-color: "#14532d" }
NEW: "new address\nno recreate" { style.fill: "#ffedd5"; style.stroke: "#ea580c"; style.font-color: "#9a3412" }
OLD -> MV -> NEW

