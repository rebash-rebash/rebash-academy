*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
direction: right
Start: "start" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
Res: "mktemp\nflock" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
Work: "work" { style.fill: "#fef9c3"; style.stroke: "#ca8a04" }
Trap: "trap cleanup\nEXIT INT TERM" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
Start -> Res -> Work -> Trap
