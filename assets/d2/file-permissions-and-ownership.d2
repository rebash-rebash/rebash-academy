direction: right
*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
Proc: "Process\neuid / egid" { style.fill: "#dbeafe"; style.stroke: "#2563eb"; style.font-color: "#1e3a8a" }
Inode: "Inode metadata\nowner · group · mode" { style.fill: "#dcfce7"; style.stroke: "#16a34a"; style.font-color: "#14532d" }
Check: "Permission check\nrwx / ACL" { style.fill: "#ffedd5"; style.stroke: "#ea580c"; style.font-color: "#9a3412" }
Allow: "Allow I/O" { style.fill: "#f3e8ff"; style.stroke: "#9333ea"; style.font-color: "#581c87" }
Deny: "EACCES" { style.fill: "#fce7f3"; style.stroke: "#db2777"; style.font-color: "#9d174d" }
Proc -> Check
Inode -> Check
Check -> Allow: match
Check -> Deny: no match
