direction: right
*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
Crontab: "crontab /\n/etc/cron.*" { style.fill: "#dbeafe"; style.stroke: "#2563eb"; style.font-color: "#1e3a8a" }
Cron: "cron daemon" { style.fill: "#dcfce7"; style.stroke: "#16a34a"; style.font-color: "#14532d" }
Timer: "systemd timer" { style.fill: "#ffedd5"; style.stroke: "#ea580c"; style.font-color: "#9a3412" }
Svc: "oneshot service" { style.fill: "#f3e8ff"; style.stroke: "#9333ea"; style.font-color: "#581c87" }
Job: "Job command\nscript" { style.fill: "#fce7f3"; style.stroke: "#db2777"; style.font-color: "#9d174d" }
Log: "Logs / mail\njournal" { style.fill: "#e2e8f0"; style.stroke: "#475569"; style.font-color: "#0f172a" }
Crontab -> Cron -> Job
Timer -> Svc -> Job
Job -> Log
