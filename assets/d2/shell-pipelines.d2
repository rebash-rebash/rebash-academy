*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
direction: right
Src: "logs / data" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
Pipe: "grep|awk|jq" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
Fn: "script\nfunction" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
Out: "metrics /\nreport" { style.fill: "#fce7f3"; style.stroke: "#db2777" }
Src -> Pipe -> Fn -> Out
