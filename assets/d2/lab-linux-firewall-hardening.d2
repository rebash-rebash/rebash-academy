*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
direction: right

Internet: "Internet /\nuntrusted" { style.fill: "#fee2e2"; style.stroke: "#dc2626" }
UFW: "UFW default deny\nin + allow SSH/HTTP" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
SSH: "SSH keys only\nno password root" { style.fill: "#fef9c3"; style.stroke: "#ca8a04" }
Host: "Hardened Ubuntu\nhost" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }

Internet -> UFW -> SSH -> Host
