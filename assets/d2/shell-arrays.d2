*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
direction: right
List: "indexed\narray" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
Map: "associative\narray" { style.fill: "#f3e8ff"; style.stroke: "#9333ea" }
Iter: "safe iterate\n\"\${a[@]}\"" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
List -> Iter
Map -> Iter
