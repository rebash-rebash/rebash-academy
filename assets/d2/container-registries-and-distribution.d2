direction: right

DEV: "Developer / CI Builder"
    BUILD: "docker build"
    REG: "Container Registry\nHub / ECR / Artifact Registry"
    RUN1: "Docker Host"
    RUN2: "Kubernetes Node"
    RUN3: "Cloud Run / ECS"
    DEV -> BUILD
    BUILD -> REG: "docker push"
    REG -> RUN1: "docker pull"
    REG -> RUN2: "kubelet pull"
    REG -> RUN3: "service pull"
