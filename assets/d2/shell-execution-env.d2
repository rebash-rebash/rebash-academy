*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
direction: right
Shebang: "Shebang\nbash" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
Env: "Inherited env\nPATH HOME" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
Shell: "bash / sh" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
Script: "Script body" { style.fill: "#f3e8ff"; style.stroke: "#9333ea" }
Shebang -> Env -> Shell -> Script
