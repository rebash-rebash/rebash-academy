*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
direction: right
YAML: ".gitlab-ci.yml" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
Job: "job script\nset -euo" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
Repo: "repo scripts/" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
Art: "artefacts" { style.fill: "#fce7f3"; style.stroke: "#db2777" }
YAML -> Job -> Repo -> Art
