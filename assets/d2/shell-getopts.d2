*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
direction: right
Argv: "argv" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
Opts: "getopts" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
Rest: "operands" { style.fill: "#fef9c3"; style.stroke: "#ca8a04" }
Work: "work" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
Argv -> Opts -> Rest -> Work
