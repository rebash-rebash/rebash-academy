        *: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
direction: right
A: "Owner/group/other" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
        B: "chmod umask" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
        C: "ACLs" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
        D: "SUID SGID sticky" { style.fill: "#fce7f3"; style.stroke: "#db2777" }
        A -> B -> C -> D
