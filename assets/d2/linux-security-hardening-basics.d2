direction: down
*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
Net: "Network edge\nfirewall · SSH only" { style.fill: "#dbeafe"; style.stroke: "#2563eb"; style.font-color: "#1e3a8a" }
Auth: "Authentication\nkeys · MFA · sudo" { style.fill: "#dcfce7"; style.stroke: "#16a34a"; style.font-color: "#14532d" }
Host: "Host lockdown\nservices · permissions" { style.fill: "#ffedd5"; style.stroke: "#ea580c"; style.font-color: "#9a3412" }
Patch: "Patch & audit\nupdates · logs" { style.fill: "#f3e8ff"; style.stroke: "#9333ea"; style.font-color: "#581c87" }
Net -> Auth -> Host -> Patch
