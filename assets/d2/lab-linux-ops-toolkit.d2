*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
direction: right

Collect: "Collectors\ncpu mem disk net" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
Scripts: "Toolkit scripts\nhealth triage" { style.fill: "#fef9c3"; style.stroke: "#ca8a04" }
Cron: "cron / timer\nschedule" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
Report: "Reports +\nexit codes" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }

Collect -> Scripts -> Cron -> Report
