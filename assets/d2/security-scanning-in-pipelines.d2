direction: right
Code: "Source" { style.fill: "#fee2e2"; style.stroke: "#b91c1c" }
SAST: "SAST / deps" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
Img: "Image scan" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
Gate: "Fail on critical" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
Code -> SAST -> Gate
Code -> Img -> Gate
