direction: right
Sym: "Symptom unreachable" { style.fill: "#fee2e2"; style.stroke: "#b91c1c" }
IAM: "IAM / caller" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
SG: "SG / NACL" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
Route: "Route / subnet" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
Fix: "Fix + validate" { style.fill: "#e0e7ff"; style.stroke: "#4338ca" }
Sym -> IAM -> SG -> Route -> Fix
