*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
direction: right
Raw: "Raw value" { style.fill: "#fee2e2"; style.stroke: "#dc2626" }
Expand: "Expansion" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
Quote: "Quotes?" { style.fill: "#fef9c3"; style.stroke: "#ca8a04" }
Safe: "One word" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
Split: "Split / glob" { style.fill: "#fce7f3"; style.stroke: "#db2777" }
Raw -> Expand -> Quote
Quote -> Safe: "yes"
Quote -> Split: "no"
