*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
direction: right
Broken: "Broken script\nunquoted rm" { style.fill: "#fee2e2"; style.stroke: "#dc2626" }
Strict: "Strict mode\nquotes" { style.fill: "#fef9c3"; style.stroke: "#ca8a04" }
Lock: "flock + trap" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
Safe: "Safe cron job" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
Broken -> Strict -> Lock -> Safe
