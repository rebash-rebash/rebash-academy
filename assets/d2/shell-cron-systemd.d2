*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
direction: right
Sched: "cron /\ntimer" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
Wrap: "wrapper\nPATH+lock" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
Job: "job script" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
Log: "log / journal" { style.fill: "#f3e8ff"; style.stroke: "#9333ea" }
Sched -> Wrap -> Job -> Log
