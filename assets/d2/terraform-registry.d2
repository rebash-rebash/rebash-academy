direction: right
*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
SRC: "source =\norg/name/provider" { style.fill: "#dbeafe"; style.stroke: "#2563eb"; style.font-color: "#1e3a8a" }
REG: "Terraform\nRegistry" { style.fill: "#dcfce7"; style.stroke: "#16a34a"; style.font-color: "#14532d" }
VER: "version\nconstraint" { style.fill: "#ffedd5"; style.stroke: "#ea580c"; style.font-color: "#9a3412" }
USE: "Root module\ncomposition" { style.fill: "#f3e8ff"; style.stroke: "#9333ea"; style.font-color: "#581c87" }
SRC -> REG -> VER -> USE

