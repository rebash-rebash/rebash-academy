*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
direction: right
Human: "Human / CI / cron" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
Script: "Bash script" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
Tools: "OS tools" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
Status: "Exit status\n+ logs" { style.fill: "#fce7f3"; style.stroke: "#db2777" }
Human -> Script -> Tools -> Status
