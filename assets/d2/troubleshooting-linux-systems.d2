direction: right
*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
Sym: "Symptom\nalert / user report" { style.fill: "#dbeafe"; style.stroke: "#2563eb"; style.font-color: "#1e3a8a" }
Scope: "Scope\nhost · service · time" { style.fill: "#dcfce7"; style.stroke: "#16a34a"; style.font-color: "#14532d" }
Check: "Checks\nCPU MEM DISK NET LOGS" { style.fill: "#ffedd5"; style.stroke: "#ea580c"; style.font-color: "#9a3412" }
Hyp: "Hypothesis" { style.fill: "#f3e8ff"; style.stroke: "#9333ea"; style.font-color: "#581c87" }
Fix: "Fix + verify" { style.fill: "#fce7f3"; style.stroke: "#db2777"; style.font-color: "#9d174d" }
Sym -> Scope -> Check -> Hyp -> Fix
