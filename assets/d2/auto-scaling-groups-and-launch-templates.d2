direction: right
LT: "Launch template" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
ASG: "Auto Scaling group" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
Healthy: "Healthy instances" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }
Metric: "CPU / ALB metric" { style.fill: "#e0e7ff"; style.stroke: "#4338ca" }
LT -> ASG -> Healthy
Metric -> ASG
