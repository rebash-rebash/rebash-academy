*: { style: { border-radius: 14; font-size: 14; bold: true; shadow: true; stroke-width: 2 } }
direction: right

Source: "Lab data/\nsource files" { style.fill: "#dbeafe"; style.stroke: "#2563eb" }
Stage: "mktemp stage\n+ trap cleanup" { style.fill: "#fef9c3"; style.stroke: "#ca8a04" }
Archive: "tar.gz\nbackups/" { style.fill: "#ffedd5"; style.stroke: "#ea580c" }
Retain: "Retention\nfind -mtime" { style.fill: "#f3e8ff"; style.stroke: "#7c3aed" }
Lock: "flock\nbackup.lock" { style.fill: "#dcfce7"; style.stroke: "#16a34a" }

Lock -> Source -> Stage -> Archive -> Retain
